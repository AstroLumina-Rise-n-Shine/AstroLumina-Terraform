<!--
  libvirt network definition — static IPs configured via cloud-init.
  
  All environments now use ipv4_address + ipv4_gateway in the libvirt_vm module,
  which configures cloud-init to pin the interface directly at first boot.
  No MAC-based DHCP reservations needed — the guest sets its own static IP.
  
  DHCP range starts at .213 to avoid conflicts with our static .210-.212.
-->
<network>
  <name>local</name>
  <forward mode='nat'/>
  <bridge name='virbr0' stp='on' delay='0'/>
  <mac address='52:54:00:xx:yy:zz'/>
  <ip address='192.168.200.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.200.213' end='192.168.200.254'/>
    </dhcp>
  </ip>
</network>